# DTC4EU production reverse proxy + static hosting.
# Domains come from the environment (deploy/.env):
#   SITE_DOMAIN      e.g. dtc4eu.eu        → public website + CMS
#   PLATFORM_DOMAIN  e.g. platform.dtc4eu.eu → evaluation platform
#   ACME_EMAIL       Let's Encrypt contact
#   STAGING_DOMAIN   optional, e.g. staging.platform.dtc4eu.eu → staging stack
#
# For a local/pre-DNS smoke test set SITE_DOMAIN=localhost and
# PLATFORM_DOMAIN=platform.localhost — Caddy then uses its internal CA.

{
	email {$ACME_EMAIL}
}

(spa) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {args[0]}
	}

	handle {
		root * {args[1]}
		try_files {path} /index.html
		file_server

		@hashed path_regexp \.(js|css|woff2?|png|jpe?g|webp|svg|gif|ico)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	import spa website-api:8090 /srv/website
}

{$PLATFORM_DOMAIN} {
	import spa platform-api:8080 /srv/platform
}

# Staging (FIX-LIST X3, deploy/docker-compose.staging.yml). Unset → a local-only
# name with an internal certificate; 502 while the staging stack is down.
{$STAGING_DOMAIN:staging.localhost} {
	encode zstd gzip
	reverse_proxy staging-web:80
	header X-Robots-Tag "noindex, nofollow"
}
