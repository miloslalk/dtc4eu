# ============================================================================
# DTC4EU staging environment — copy to deploy/staging.env (never committed).
# Every secret MUST differ from production: a staging token must never be
# accepted by production. Generate with:  openssl rand -base64 48
# ============================================================================

# Hostname served by the production Caddy (add an A record, like "platform")
STAGING_DOMAIN=staging.platform.dtc4.eu

POSTGRES_SUPER_PASSWORD=change-me
PLATFORM_DB_PASSWORD=change-me
PLATFORM_JWT_SECRET=change-me-openssl-rand-base64-48
MINIO_ROOT_USER=dtc4eu-staging
MINIO_ROOT_PASSWORD=change-me

# Password every anonymised account gets after a refresh (share it with testers)
STAGING_USER_PASSWORD=change-me
