# ============================================================================
# DTC4EU production environment — copy to deploy/.env and fill in EVERY value.
# Generate secrets with:  openssl rand -base64 48
# NEVER commit deploy/.env.
# ============================================================================

# --- Domains & TLS ----------------------------------------------------------
# Public website (also served on www.<SITE_DOMAIN>)
SITE_DOMAIN=dtc4.eu
# Evaluation platform
PLATFORM_DOMAIN=platform.dtc4.eu
# Let's Encrypt contact address (expiry warnings go here)
ACME_EMAIL=admin@example.eu

# Optional: staging hostname, proxied to deploy/docker-compose.staging.yml
# STAGING_DOMAIN=staging.platform.dtc4.eu

# For a local smoke test before DNS exists use:
#   SITE_DOMAIN=localhost
#   PLATFORM_DOMAIN=platform.localhost
# (Caddy then issues certificates from its internal CA.)

# --- PostgreSQL -------------------------------------------------------------
# Superuser (used only by init + backups)
POSTGRES_SUPER_PASSWORD=change-me
# Per-application database users
PLATFORM_DB_PASSWORD=change-me
WEBSITE_DB_PASSWORD=change-me

# --- JWT signing secrets (>= 32 chars, DIFFERENT from each other) -----------
PLATFORM_JWT_SECRET=change-me-openssl-rand-base64-48
WEBSITE_JWT_SECRET=change-me-openssl-rand-base64-48

# --- First-login passwords for the seeded admin accounts --------------------
# Replace the passwords published in the repository (platform `admin`, website
# `webadmin`) at start-up. Both APIs refuse to start while a published password
# still works and these are empty. Private, different, then changed at first login.
PLATFORM_SEED_ADMIN_PASSWORD=
WEBSITE_SEED_ADMIN_PASSWORD=

# --- MinIO object storage ---------------------------------------------------
MINIO_ROOT_USER=dtc4eu-admin
MINIO_ROOT_PASSWORD=change-me

# ============================================================================
# AFTER FIRST DEPLOY (see DEPLOY.md):
#  1. Log into https://<PLATFORM_DOMAIN> as admin / Dtc4eu!Admin2026 — the
#     platform forces a new password before anything else (V16)
#     and https://<SITE_DOMAIN>/admin as webadmin / Dtc4eu!Web2026
#  2. CHANGE THE WEBSITE PASSWORD IMMEDIATELY — it is a public dev seed.
#  3. In the CMS: Settings -> Platform link -> https://<PLATFORM_DOMAIN>
# ============================================================================
